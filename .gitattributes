* text=auto
*.cs text eol=lf diff=csharp
*.md text eol=lf
*.json text eol=lf

# Unity YAML: merge with UnityYAMLMerge if configured, never auto-merge as plain text
*.unity merge=unityyamlmerge eol=lf
*.prefab merge=unityyamlmerge eol=lf
*.asset merge=unityyamlmerge eol=lf
*.mat merge=unityyamlmerge eol=lf
*.anim merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.meta text eol=lf

# Binary
*.png binary
*.jpg binary
*.psd binary
*.fbx binary
*.glb binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
