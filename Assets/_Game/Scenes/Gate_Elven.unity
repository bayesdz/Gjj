  line: "\u0422\u0432\u043E\u0438 \u0433\u043B\u0430\u0437\u0430 \u043B\u0433\u0443\u0442
    \u0442\u0435\u0431\u0435, \u043F\u0443\u0442\u043D\u0438\u043A. \u042D\u0442\u043E
    \u043D\u0435 \u0442\u0432\u043E\u044F \u0432\u0438\u043D\u0430. \u041D\u043E
    \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
    \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0438\u043D\u0430\u0447\u0435."
