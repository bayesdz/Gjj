  itemId: z1_drawing
  title: "\u0420\u0438\u0441\u0443\u043D\u043E\u043A \u043D\u0430 \u043A\u0430\u043C\u043D\u0435"
  illusionText: "\u0417\u043D\u0430\u043A\u0438 \u0442\u0451\u043C\u043D\u043E\u0433\u043E
    \u043A\u0443\u043B\u044C\u0442\u0430. \u041E\u043D\u0438 \u043F\u0440\u0438\u0437\u044B\u0432\u0430\u044E\u0442
    \u0441\u043C\u0435\u0440\u0442\u044C."
  truthText: "\u0414\u0435\u0442\u0441\u043A\u0438\u0439 \u0440\u0438\u0441\u0443\u043D\u043E\u043A
    \u0443\u0433\u043B\u0451\u043C: \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0441\u0435\u043C\u044C\u044F
    \u0433\u043E\u0431\u043B\u0438\u043D\u043E\u0432 \u0443 \u043A\u043E\u0441\u0442\u0440\u0430."
  narrationKey: z1.item_drawing
