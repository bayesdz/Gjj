--- !u!114 &761513748
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 761513746}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7acec0da1173a9a438947083702747b6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FalseParadise.TalkNpc
  npcId: ogre_smith
  speaker: "\u041E\u0433\u0440-\u043A\u0443\u0437\u043D\u0435\u0446"
  requiresEye: 1
  lines:
  - "\u042F \u043A\u0443\u044E \u043F\u043E\u0434\u043A\u043E\u0432\u044B \u0438
    \u043E\u0433\u0440\u0430\u0434\u044B. \u041D\u0435 \u043C\u0435\u0447\u0438.
    \u041D\u0430\u043C \u043D\u0435 \u0441 \u043A\u0435\u043C \u0431\u044B\u043B\u043E
    \u0432\u043E\u0435\u0432\u0430\u0442\u044C\u2026 \u0434\u043E \u0432\u0430\u0441."
  - "\u041F\u0440\u0438\u0448\u0435\u043B\u044C\u0446\u044B \u0441 \u0441\u0438\u044F\u043D\u0438\u0435\u043C
    \u0442\u0440\u0435\u0442\u0438\u0439 \u043C\u0435\u0441\u044F\u0446 \u0436\u0433\u0443\u0442
    \u043D\u0430\u0448\u0438 \u0434\u0435\u0440\u0435\u0432\u043D\u0438."
  - "\u0412\u043E\u0436\u0434\u044C \u0436\u0438\u0432\u0451\u0442 \u0432 \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u0438
    \u043D\u0430\u0432\u0435\u0440\u0445\u0443. \u0418\u0434\u0438 \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435
    \u0432 \u0433\u043E\u0440\u0443 \u2014 \u043E\u043D \u043C\u0443\u0434\u0440\u044B\u0439
    \u0438 \u043D\u0435 \u0445\u043E\u0447\u0435\u0442 \u0432\u043E\u0439\u043D\u044B."
  narrationKeyOnFirstTalk: z2.smith_talk_done
