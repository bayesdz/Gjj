  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 557882681cfa1e94292fb90729b7d160, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FalseParadise.InspectItem
  itemId: z2_letter
  title: "\u041F\u0438\u0441\u044C\u043C\u043E"
  illusionText: "\u0421\u043F\u0438\u0441\u043E\u043A \u0436\u0435\u0440\u0442\u0432
    \u0434\u043B\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
    \u043D\u0430\u0431\u0435\u0433\u0430. \u041D\u0435 \u0447\u0438\u0442\u0430\u0439
    \u0438\u0445 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u0435 \u0437\u043D\u0430\u043A\u0438."
  truthText: "\u041F\u0438\u0441\u044C\u043C\u043E \u0441\u044B\u043D\u0443: \xAB\u041D\u0435
    \u0445\u043E\u0434\u0438 \u043A \u0441\u0442\u0430\u0440\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0435.
    \u0422\u0430\u043C \u0441\u043D\u043E\u0432\u0430 \u0432\u0438\u0434\u0435\u043B\u0438
    \u0441\u0438\u044F\u043D\u0438\u0435. \u041C\u0430\u043C\u0430 \u0436\u0434\u0451\u0442
    \u043A \u0443\u0436\u0438\u043D\u0443\xBB."
  narrationKey: z2.item_letter
