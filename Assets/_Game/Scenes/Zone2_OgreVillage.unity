  m_Script: {fileID: 11500000, guid: 557882681cfa1e94292fb90729b7d160, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FalseParadise.InspectItem
  itemId: z2_cradle
  title: "\u041A\u043E\u043B\u044B\u0431\u0435\u043B\u044C"
  illusionText: "\u041B\u043E\u0432\u0443\u0448\u043A\u0430. \u041E\u043D\u0438 \u043A\u043B\u0430\u0434\u0443\u0442
    \u0442\u0443\u0434\u0430 \u043F\u0440\u0438\u043C\u0430\u043D\u043A\u0443 \u0434\u043B\u044F
    \u043F\u043B\u0435\u043D\u043D\u0438\u043A\u043E\u0432."
  truthText: "\u0414\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0430\u044F \u043A\u043E\u043B\u044B\u0431\u0435\u043B\u044C,
    \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u043D\u0430\u044F \u0432\u0440\u0443\u0447\u043D\u0443\u044E.
    \u041F\u043E\u0434 \u043E\u0434\u0435\u044F\u043B\u043E\u043C \u2014 \u0442\u0440\u044F\u043F\u0438\u0447\u043D\u0430\u044F
    \u043A\u0443\u043A\u043B\u0430."
  narrationKey: z2.item_cradle
