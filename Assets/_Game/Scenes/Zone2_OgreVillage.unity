MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1314250441}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ef7373a519879d443b4482dc216187aa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FalseParadise.ChiefChoice
  chief: {fileID: 1673219059}
  stairs: {fileID: 1127831967}
  speaker: "\u041E\u0433\u0440-\u0432\u043E\u0436\u0434\u044C"
  speech: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0441\u044C. \u0422\u044B
    \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0448\u044C \u043D\u0430\u0441 \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u0430\u043C\u0438,
    \u043D\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438, \u043A\u043E\u0433\u043E
    \u0442\u044B \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0430\u043B. \u0422\u0435
    \u0421\u0438\u044F\u044E\u0449\u0438\u0435 \u2014 \u0435\u0451 \u0441\u043B\u0443\u0433\u0438.
    \u041C\u044B \u043B\u043E\u0432\u0438\u043B\u0438 \u0438\u0445, \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u043E\u043D\u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
    \u0443\u0431\u0438\u0432\u0430\u0442\u044C \u043D\u0430\u0441."
  spareLine: "\u0415\u0441\u043B\u0438 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F
    \u043F\u043E\u043C\u043E\u0449\u044C, \u043D\u0430\u0448 \u043D\u0430\u0440\u043E\u0434
    \u043F\u0440\u0438\u0434\u0451\u0442."
  speechKey: z2.chief_speech
  sparedKey: z2.chief_spared
  killedKey: z2.chief_killed
  stairsDelay: 4
